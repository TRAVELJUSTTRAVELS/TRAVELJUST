rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'traveljustmysuru@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin', 'super_admin'])
      );
    }

    function isFleetStaff() {
      return isAuthenticated() && (
        isOwner() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['fleet_manager', 'fleet_staff', 'dispatcher', 'driver'])
      );
    }

    function isUserSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile documents (Customers, Staff, Owners)
    match /users/{userId} {
      allow read: if isUserSelf(userId) || isOwner() || isFleetStaff();
      allow create, update: if isUserSelf(userId) || isOwner();
      allow delete: if isOwner();

      // User bookings subcollection
      match /bookings/{bookingId} {
        allow read: if isUserSelf(userId) || isFleetStaff() || isOwner();
        allow write: if isUserSelf(userId) || isFleetStaff() || isOwner();
      }
    }

    // Central Bookings collection
    match /bookings/{bookingId} {
      // Customers read their own bookings; Fleet staff and Owners read all bookings
      allow read: if isFleetStaff() || isOwner() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (resource.data.customerEmail != null && resource.data.customerEmail == request.auth.token.email) ||
          (resource.data.customerPhone != null && request.auth.token.phone_number != null &&
           request.auth.token.phone_number.matches('.*' + resource.data.customerPhone + '.*'))
        )
      );

      // Anyone (including guests) can initiate a booking request
      allow create: if true;

      // Fleet staff can update dispatch/driver/trip status; Owners have full edit/delete; Customers can update their own
      allow update: if isFleetStaff() || isOwner() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      allow delete: if isOwner();
    }

    // Public / Shared dynamic fare engine configuration
    match /settings/fareConfig {
      allow read: if true;
      allow write: if isOwner();
    }

    // General app settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Fleet & Vehicles (Read by public/customers for booking, modified by Fleet & Owner)
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isFleetStaff() || isOwner();
    }

    // Chauffeurs & Drivers (Read by authenticated customers/fleet, managed by Fleet & Owner)
    match /chauffeurs/{chauffeurId} {
      allow read: if isAuthenticated() || isFleetStaff() || isOwner();
      allow write: if isFleetStaff() || isOwner();
    }

    // Discounts & Promo Codes (Read by public for quote validation, modified by Owner)
    match /discounts/{discountId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Site Optimizer & SEO Settings
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Payments & Invoices (Visible to passenger, fleet manager & owner; created/managed by staff & owner)
    match /payments/{paymentId} {
      allow read: if isFleetStaff() || isOwner() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.customerEmail == request.auth.token.email
        )
      );
      allow write: if isFleetStaff() || isOwner();
    }

    // Central WhatsApp Communication logs
    match /whatsapp_messages/{messageId} {
      allow read: if isFleetStaff() || isOwner();
      allow write: if isFleetStaff() || isOwner();
    }

    // Audit logs (Immutable system trail; read only by Owner)
    match /audit_logs/{logId} {
      allow read: if isOwner();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
