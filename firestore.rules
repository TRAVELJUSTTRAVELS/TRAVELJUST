rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'traveljustmysuru@gmail.com');
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'traveljustmysuru@gmail.com');

      // User bookings subcollection
      match /bookings/{bookingId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'traveljustmysuru@gmail.com');
      }
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email ||
        request.auth.token.email == 'traveljustmysuru@gmail.com'
      );
      allow create: if true;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.email == 'traveljustmysuru@gmail.com'
      );
    }

    // Public / Shared fare configuration
    match /settings/fareConfig {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fleet & Vehicles
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'traveljustmysuru@gmail.com';
    }

    // Chauffeurs
    match /chauffeurs/{chauffeurId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'traveljustmysuru@gmail.com';
    }

    // Discounts & Promo Codes
    match /discounts/{discountId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'traveljustmysuru@gmail.com';
    }

    // Site Optimizer & SEO Settings
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'traveljustmysuru@gmail.com';
    }

    // Payments & Invoices
    match /payments/{paymentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'traveljustmysuru@gmail.com';
    }

    // WhatsApp Communications
    match /whatsapp_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read: if request.auth != null && request.auth.token.email == 'traveljustmysuru@gmail.com';
      allow write: if request.auth != null;
    }
  }
}
