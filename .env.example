# GOOGLE MAPS PLATFORM CONFIGURATION:
# API Key used for Places API (New), Routes API, and Maps JS SDK.
# For zero-cost prototyping, you can generate a free Maps Demo Key:
# https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_mcp_codeassist_v1_aistudio
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPTIONAL SUPABASE CONFIGURATION (Leave blank for local storage mode):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SMS GATEWAY CONFIGURATION:
# Provider options: fast2sms | msg91 | twilio | custom | simulated (default fallback)
SMS_GATEWAY_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID="TRVJST"
SMS_DLT_TE_ID=

# Provider specific keys (optional):
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_WEBHOOK_URL=



